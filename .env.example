APP_NAME=Moves
APP_ENV=development
APP_DEBUG=true
APP_URL=http://mvs.lab
APP_TIMEZONE=America/Sao_Paulo

# Em produção use HTTPS e mantenha estes três valores seguros.
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=43200

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=moves
DB_USERNAME=root
DB_PASSWORD=

# Recuperação de conta. Use credenciais reais somente no .env local/produção.
MAIL_TRANSPORT=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_ENCRYPTION=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@moves.local
MAIL_FROM_NAME=Moves

# MFA transversal. Gere uma chave de 32 bytes e armazene apenas no ambiente.
MFA_KEY_ID=moves-mfa-v1
MFA_KEY=
