APP_NAME=Moves
APP_ENV=development
APP_DEBUG=true
APP_URL=http://mvs.lab
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=moves
DB_USERNAME=root
DB_PASSWORD=

# Moves Talk / WhatsApp
# Desenvolvimento local gratuito via bridge Baileys.
# Para produção oficial, altere para meta_cloud e configure as credenciais Meta abaixo.
TALK_WHATSAPP_DRIVER=baileys
TALK_BAILEYS_URL=http://127.0.0.1:3011
TALK_BAILEYS_BRIDGE_TOKEN=
TALK_WHATSAPP_PHONE_NUMBER_ID=
TALK_WHATSAPP_ACCESS_TOKEN=
TALK_WHATSAPP_GRAPH_VERSION=v23.0
